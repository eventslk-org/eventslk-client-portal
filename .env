# ──────────────────────────────────────────────────────────────────────────────
# EventsLK Client Portal — runtime configuration
#
# API_BASE_URL is the public base URL of the EventsLK API Gateway (the single
# external entry point). All client calls go to ${API_BASE_URL}/api/v1/...
#
# Local dev / single-node k8s : http://localhost:30080  (gateway NodePort)
# Production                   : https://api.your-domain.com
#
# This value is baked into env-config.js at container start by docker-entrypoint.sh
# (envsubst). In Kubernetes it is supplied via the deployment's API_BASE_URL env var.
#
# NOTE: for emailed verification links to land on this portal's verify page, set the
# backend (event-registration-api) APP_BASE_URL to this portal's public URL, e.g.
# http://localhost:30081 — nginx serves /auth/verify-email -> verify.html.
# ──────────────────────────────────────────────────────────────────────────────
# API_BASE_URL=http://localhost:30080

API_BASE_URL=http://localhost:8000
